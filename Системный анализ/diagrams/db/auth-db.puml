@startuml auth-db
title Trajectory — ER: auth_db (Auth Service, target model)

hide circle
skinparam linetype ortho

entity "identities" as identities {
  * id : uuid <<PK>>
  --
  * identity_type : text  -- USER | STAFF
  email : citext <<UQ>>
  * status : text
  email_confirmed_at : timestamptz
  deletion_at : timestamptz
  anonymized_at : timestamptz
}

entity "user_identities" as users {
  * identity_id : uuid <<PK, FK>>
}

entity "staff_identities" as staff {
  * identity_id : uuid <<PK, FK>>
  --
  * display_name : text
}

entity "identity_learning_roles" as learning_roles {
  * identity_id : uuid <<PK, FK>>
  * role_code : text <<PK>>
}

entity "admin_roles" as admin_roles {
  * id : uuid <<PK>>
  --
  * code : text <<UQ>>
  * name : text <<UQ>>
  * system : boolean
}

entity "permissions" as permissions {
  * code : text <<PK>>
  --
  * description : text
  * dangerous : boolean
}

entity "admin_role_permissions" as role_permissions {
  * role_id : uuid <<PK, FK>>
  * permission_code : text <<PK, FK>>
}

entity "staff_role_assignments" as staff_roles {
  * identity_id : uuid <<PK, FK>>
  * role_id : uuid <<PK, FK>>
}

entity "credentials" as credentials {
  * identity_id : uuid <<PK, FK>>
  --
  * password_hash : text
  * updated_at : timestamptz
}

entity "oauth_connections" as oauth {
  * id : uuid <<PK>>
  --
  * identity_id : uuid <<FK>>
  * provider : text
  * provider_subject : text
}

entity "sessions" as sessions {
  * id : uuid <<PK>>  -- refresh family_id
  --
  * identity_id : uuid <<FK>>
  * login_method : text
  * last_ip : inet
  * last_active_at : timestamptz
  * expires_at : timestamptz
  revoked_at : timestamptz
}

entity "refresh_tokens" as refresh {
  * id : uuid <<PK>>
  --
  * family_id : uuid <<FK>>
  * token_hash : bytea <<UQ>>
  * status : text
  replaced_by : uuid <<FK self>>
  * expires_at : timestamptz
}

entity "auth_action_requests" as actions {
  * id : uuid <<PK>>
  --
  identity_id : uuid <<FK>>
  * kind : text
  * token_hash : bytea <<UQ>>
  pending_email : citext
  * expires_at : timestamptz
  consumed_at : timestamptz
}

entity "auth_audit_log" as audit {
  * id : uuid <<PK>>
  --
  * event_type : text
  actor_audit_ref : uuid
  object_audit_ref : uuid
  * result : text
  * request_id : text
  * created_at : timestamptz
}

entity "signing_keys" as keys {
  * kid : text <<PK>>
  --
  * public_jwk : jsonb
  * encrypted_private_key : bytea
  * status : text
}

entity "outbox" as outbox {
  * event_id : uuid <<PK>>
  --
  * aggregate_id : uuid
  * topic : text
  * event_type : text
  * message_key : text
  * payload : bytea
  published_at : timestamptz
}

identities ||--o| users
identities ||--o| staff
users ||--|{ learning_roles
staff ||--|{ staff_roles
staff_roles }o--|| admin_roles
admin_roles ||--|{ role_permissions
role_permissions }o--|| permissions
identities ||--o| credentials
users ||--o{ oauth
identities ||--o{ sessions
sessions ||--o{ refresh
identities ||--o{ actions
refresh |o--o| refresh : replaced_by

note bottom of identities
  USER и STAFF subtype взаимоисключающие;
  deleted identity освобождает email
end note

note bottom of sessions
  максимум 10 active sessions на identity;
  inactivity TTL 30 дней
end note

note bottom of refresh
  UNIQUE family_id WHERE status='ACTIVE';
  raw token не хранится
end note
@enduml
