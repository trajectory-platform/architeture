@startuml realtime-db
title Trajectory — ER: realtime_db (с MVP 1.0)
hide circle
skinparam linetype ortho
entity "board_rooms" as rooms {
  * lesson_id : uuid <<PK>>
  --
  * last_seq : bigint
  * snapshot_seq : bigint
}
entity "board_updates" as updates {
  * lesson_id : uuid <<PK, FK>>
  * seq : bigint <<PK>>
  --
  * update : bytea
  * created_at : timestamptz
}
entity "board_update_receipts" as receipts {
  * lesson_id : uuid <<PK, FK>>
  * update_id : uuid <<PK>>
  --
  * digest : bytea
  * seq : bigint
  * expires_at : timestamptz
}
entity "board_snapshots" as snapshots {
  * lesson_id : uuid <<PK, FK>>
  * upto_seq : bigint <<PK>>
  --
  * snapshot : bytea
  * created_at : timestamptz
}
rooms ||--o{ updates
rooms ||--o{ receipts
rooms ||--o{ snapshots
note bottom of rooms
  UPDATE last_seq + INSERT update/receipt в одной tx;
  last_seq не уменьшается при pruning;
  snapshot_seq переключается атомарно с публикацией.
end note
note bottom of snapshots
  После pruning snapshot + tail обязательны.
  Чтение согласованное; удаление только покрытых bytes.
  Client snapshot не разрешает pruning.
  Receipts переживают удаление bytes до конца replay window.
end note
@enduml
