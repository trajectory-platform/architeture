@startuml education-db
title Trajectory — ER: education_db (Core Education Service)

hide circle
skinparam linetype ortho

entity "profiles" as profiles {
  * user_id : uuid <<PK>>
  --
  * display_name : text
  * timezone : text
  avatar_key : text
  * created_at : timestamptz
}

entity "availability_rules" as availability {
  * id : uuid <<PK>>
  --
  * teacher_id : uuid
  * weekday : smallint
  * start_time : time
  * end_time : time
  * timezone : text
}

entity "slots" as slots {
  * id : uuid <<PK>>
  --
  * teacher_id : uuid
  * time_range : tstzrange
  source_rule_id : uuid <<FK>>
  * status : text
}

entity "bookings" as bookings {
  * id : uuid <<PK>>
  --
  * teacher_id : uuid
  * time_range : tstzrange
  * status : text
  idempotency_key : text <<UQ>>
  * created_at : timestamptz
}

entity "booking_participants" as booking_participants {
  * id : uuid <<PK>>
  --
  * booking_id : uuid <<FK>>
  * student_id : uuid -- UNIQUE (booking_id, student_id)
  --
  * status : text
  * price_amount : bigint
  * currency : char(3)
  * hold_reference_id : uuid <<UQ>>
}

entity "lessons" as lessons {
  * id : uuid <<PK>>
  --
  * booking_id : uuid <<UQ, FK>>
  * teacher_id : uuid
  * time_range : tstzrange
  * status : text
  * livekit_room : text <<UQ>>
  started_at : timestamptz
  ended_at : timestamptz
}

entity "lesson_participants" as lesson_participants {
  * lesson_id : uuid <<PK, FK>>
  * user_id : uuid <<PK>>
  --
  * role : text
  * booking_status : text
}

entity "lesson_attendance" as attendance {
  * lesson_id : uuid <<PK, FK>>
  * user_id : uuid <<PK>>
  * joined_at : timestamptz <<PK>>
  --
  left_at : timestamptz
}

entity "lesson_recordings" as recordings {
  * id : uuid <<PK>>
  --
  * lesson_id : uuid <<FK>>
  object_key : text <<UQ>> -- до READY может отсутствовать
  * status : text
  ready_at : timestamptz
  delete_after : timestamptz
  deleted_at : timestamptz
}

entity "recording_consents" as consents {
  * recording_id : uuid <<PK, FK>>
  * user_id : uuid <<PK>>
  --
  * consented : boolean
  * decided_at : timestamptz
}

entity "chats" as chats {
  * id : uuid <<PK>>
  --
  * kind : text
  lesson_id : uuid
  title : text
}

entity "chat_members" as chat_members {
  * chat_id : uuid <<PK, FK>>
  * user_id : uuid <<PK>>
  --
  * role : text
  last_read_at : timestamptz
}

entity "messages" as messages {
  * id : uuid <<PK>>
  --
  * chat_id : uuid <<FK>>
  * sender_id : uuid
  body : text
  attachment_key : text
  * created_at : timestamptz
}

entity "support_tickets" as tickets {
  * chat_id : uuid <<PK, FK>>
  --
  * status : text
  assignee_id : uuid
}

entity "webhook_inbox" as webhooks {
  * provider_event_id : text <<PK>>
  --
  * event_type : text
  * room_id : text
  * received_at : timestamptz
  * safe_payload : jsonb
}

entity "processed_events" as processed {
  * event_id : uuid <<PK>>
  --
  * event_type : text
  * processed_at : timestamptz
}

entity "outbox" as outbox {
  * id : bigserial <<PK>>
  --
  * event_id : uuid <<UQ>>
  * aggregate_version : bigint
  * aggregate_id : uuid
  * topic : text
  * event_type : text
  * payload : bytea
  * created_at : timestamptz
  published_at : timestamptz
}

availability ||--o{ slots : source_rule
bookings ||--|{ booking_participants
bookings ||--o| lessons
lessons ||--|{ lesson_participants
lessons ||--o{ attendance
lessons ||--o{ recordings
recordings ||--|{ consents
chats ||--o{ chat_members
chats ||--o{ messages
chats ||--o| tickets

note bottom of bookings
  EXCLUDE USING gist
  (teacher_id WITH =, time_range WITH &&)
  WHERE status IN ('PENDING','CONFIRMED')
end note

note bottom of booking_participants
  цена фиксируется с каждого ученика;
  hold_reference_id = participant.id;
  вместимость PENDING+CONFIRMED под booking row lock
end note

note bottom of recordings
  READY: delete_after = ready_at + 1 month;
  REQUESTED/RECORDING/PROCESSING/READY;
  DELETING -> DELETED, либо FAILED;
  после срока access закрыт, S3 удаляется с retry
end note
@enduml
