@startuml core-education-modules
title Trajectory — Core Education: модули и разрешённые зависимости

left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

package "Driving adapters" {
  component "education.v1\ngRPC transport" as grpc
  component "Kafka consumers" as consumers
  component "Background jobs" as jobs
}

package "Core Education modular monolith" {
  component "profiles\n<<module>>\nпрофили, timezone" as profiles
  component "scheduling\n<<module>>\nдоступность, слоты" as scheduling
  component "booking\n<<module>>\nброни, participants,\nprice snapshots" as booking
  component "lessons\n<<module>>\nуроки, attendance,\nmembership" as lessons
  component "recordings\n<<module>>\nсогласия, Egress,\nretention" as recordings
  component "chats\n<<module>>\nчаты, сообщения,\nread state" as chats
  component "support\n<<module>>\nобращения" as support
  component "uploads\n<<module>>\npresigned access" as uploads

  component "event writer\n<<shared port>>" as event_writer
  component "outbox relay\n<<infrastructure>>" as relay
}

database "education_db\nтаблицы разделены\nпо module ownership" as db
queue "Apache Kafka" as kafka
cloud "S3 / MinIO" as s3
cloud "LiveKit" as livekit
component "Billing Service" as billing

grpc --> profiles
grpc --> scheduling
grpc --> booking
grpc --> lessons
grpc --> recordings
grpc --> chats
grpc --> support
grpc --> uploads

consumers --> profiles : user.registered
consumers --> booking : payment.captured
consumers --> lessons : enrollment.expiring

jobs --> scheduling : materialize slots
jobs --> booking : reconcile pending
jobs --> recordings : delete after 1 month

booking --> scheduling : public application port\nreserve slot
lessons --> booking : public application port\nconfirmed participants
recordings --> lessons : public application port\nmembership and lifecycle
chats --> lessons : public application port\nlesson membership

profiles --> uploads : public application port
recordings --> uploads : public application port
chats --> uploads : public application port
support --> uploads : public application port

booking --> billing : gRPC PlaceHold
lessons --> livekit : Server SDK
recordings --> livekit : Egress API
uploads --> s3 : S3 API

profiles --> db : owns profile tables
scheduling --> db : owns scheduling tables
booking --> db : owns booking tables
lessons --> db : owns lesson tables
recordings --> db : owns recording tables
chats --> db : owns chat tables
support --> db : owns support tables

booking --> event_writer
lessons --> event_writer
recordings --> event_writer
chats --> event_writer
support --> event_writer
event_writer --> db : same transaction
relay --> db : read outbox
relay --> kafka : publish

note bottom of event_writer
  Стрелка между модулями означает вызов
  публичного application port.
  Импорт internal-пакетов другого модуля
  и cross-module SQL запрещены.
end note

@enduml
