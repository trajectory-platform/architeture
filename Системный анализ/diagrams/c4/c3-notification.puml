@startuml c3-notification
!include <C4/C4_Component>

title Trajectory — C3: Notification Service (components)

Container(gateway, "API Gateway", "Go", "Inbox и настройки")
Container(nginx, "Nginx", "Reverse proxy", "WebSocket route")
Container(auth, "Auth Service", "Go", "GetPasswordResetDelivery")
ContainerDb(pg_notification, "notification_db", "PostgreSQL")
ContainerDb(redis, "Redis", "Redis", "Эфемерный in-app fan-out")
ContainerQueue(kafka, "Apache Kafka", "KRaft")
System_Ext(email, "Email provider", "Транзакционные письма")
System_Ext(push, "Push provider", "Этап 2")

Container_Boundary(notification, "Notification Service") {
    Component(grpc_api, "gRPC API (notification.v1)", "Go, grpc-go", "ListNotifications, MarkRead, UpdatePreferences")
    Component(ws_api, "WebSocket API", "Go", "Живые in-app уведомления; JWT по JWKS")
    Component(consumers, "Kafka Consumers", "Go goroutines", "Consumer group, dedup event_id, materialize inbox")
    Component(renderer, "Template Renderer", "Go package", "Экранирование данных, versioned templates")
    Component(workers, "Delivery Workers", "Go goroutines", "SKIP LOCKED, retry/backoff, provider limits")
    Component(outbox_relay, "Outbox Relay", "Go goroutine", "notification.created/delivered/failed")
}

Rel(gateway, grpc_api, "Inbox и preferences", "gRPC")
Rel(nginx, ws_api, "/ws/notifications", "WebSocket")
Rel(grpc_api, pg_notification, "R/W", "SQL")
Rel(ws_api, pg_notification, "Восстановить пропущенное", "SQL")
Rel(ws_api, redis, "Получить live signal", "RESP Pub/Sub")
Rel(kafka, consumers, "domain events", "Kafka protocol")
Rel(consumers, auth, "GetPasswordResetDelivery", "gRPC, workload identity")
Rel(consumers, renderer, "Render безопасного payload")
Rel(consumers, pg_notification, "processed_events + notifications + deliveries", "SQL transaction")
Rel(consumers, redis, "Опубликовать live signal", "RESP Pub/Sub")
Rel(workers, pg_notification, "Claim/update deliveries", "SQL")
Rel(workers, email, "Send", "HTTPS")
Rel(workers, push, "Send", "HTTPS")
Rel(outbox_relay, pg_notification, "Читает outbox", "SQL")
Rel(outbox_relay, kafka, "notification lifecycle events", "Kafka protocol")

SHOW_LEGEND()
@enduml
