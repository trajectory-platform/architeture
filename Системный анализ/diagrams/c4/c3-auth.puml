@startuml c3-auth
!include <C4/C4_Component>

title Trajectory — C3: Auth Service (components)

Container(gateway, "API Gateway", "Go", "REST -> gRPC; кэширует JWKS, валидирует access JWT локально")
Container(realtime, "Realtime Service", "Go", "Кэширует JWKS (валидация room JWT)")
ContainerDb(pg_auth, "auth_db", "PostgreSQL", "identities, roles, permissions, credentials, OAuth, sessions, actions, audit, keys, outbox")
ContainerDb(redis, "Redis", "Redis", "Блэклист jti отозванных access-токенов (опционально)")
ContainerQueue(kafka, "Apache Kafka", "KRaft", "trajectory.auth.events.v1")
Container(core, "Core Education Service", "Go", "Консьюмер user.registered: создание профиля")
Container(notification, "Notification Service", "Go", "Consumer auth events; кэширует JWKS для своего WebSocket")

Container_Boundary(auth, "Auth Service") {
    Component(grpc_api, "gRPC API", "Go, transport/grpc", "Identity, login, sessions, OAuth, action requests, role administration")
    Component(jwks_ep, "JWKS Endpoint", "Go, transport/http", "GET /.well-known/jwks.json: публичные ключи ACTIVE/NEXT/RETIRING")
    Component(registrar, "Registrar", "Go use case", "Identity + subtype + role + credential + confirmation + audit + outbox")
    Component(pwd, "Password Verifier", "Go, internal/infra/argon2id + repository/postgres", "argon2id: хэширование и проверка; dummy-hash при неизвестном email")
    Component(issuer, "Token Issuer", "Go, internal/infra/token", "Ed25519 JWT: identity_type, roles[], permissions[], session_id")
    Component(refresh_mgr, "Session Manager", "Go use case", "До 10 sessions; refresh rotation; reuse = revoke family")
    Component(access, "Access Manager", "Go use case", "Learning roles, admin roles, permissions и superadmin invariants")
    Component(actions, "Action Requests", "Go use case", "Email confirmation, reset, invitation, email change")
    Component(oauth, "OAuth Manager", "Go use case", "Яндекс ID, VK ID, Google; explicit account linking")
    Component(audit, "Audit", "Go repository", "Append-only auth audit в business transaction")
    Component(key_mgr, "Key Manager", "Go, service -> repository/postgres + internal/infra/keycrypto", "Жизненный цикл ключей: NEXT -> ACTIVE -> RETIRING -> RETIRED")
    Component(outbox_relay, "Outbox Relay", "Go, pkg/outbox (started by app)", "FOR UPDATE SKIP LOCKED -> publish -> ack -> published_at")
}

Rel(gateway, grpc_api, "Register / Login / Refresh / Logout", "gRPC")
Rel(gateway, jwks_ep, "Обновление кэша ключей (TTL, kid-промах)", "HTTP")
Rel(realtime, jwks_ep, "Обновление кэша ключей", "HTTP")
Rel(notification, jwks_ep, "Обновление кэша ключей", "HTTP")

Rel(grpc_api, registrar, "Register")
Rel(grpc_api, pwd, "Login: проверка пароля")
Rel(grpc_api, refresh_mgr, "Refresh / Logout")
Rel(grpc_api, access, "Roles / permissions")
Rel(grpc_api, actions, "Confirmation / recovery / invitations")
Rel(grpc_api, oauth, "OAuth login / linking")
Rel(grpc_api, issuer, "Выдача access JWT")

Rel(registrar, pg_auth, "INSERT identities, credentials, outbox (одна транзакция)", "SQL")
Rel(pwd, pg_auth, "SELECT credentials", "SQL")
Rel(refresh_mgr, pg_auth, "refresh_tokens: ротация, отзыв семьи", "SQL")
Rel(access, pg_auth, "roles, permissions, assignments", "SQL")
Rel(actions, pg_auth, "auth_action_requests + outbox", "SQL")
Rel(oauth, pg_auth, "oauth_connections + sessions", "SQL")
Rel(audit, pg_auth, "auth_audit_log", "SQL")
Rel(refresh_mgr, redis, "Блэклист jti при отзыве семьи", "RESP")
Rel(issuer, key_mgr, "Текущий ACTIVE-ключ")
Rel(key_mgr, pg_auth, "signing_keys", "SQL")
Rel(jwks_ep, key_mgr, "Публичные JWK")

Rel(outbox_relay, pg_auth, "Неопубликованные строки outbox", "SQL")
Rel(outbox_relay, kafka, "publish auth events", "Kafka protocol")
Rel(kafka, core, "user.registered (consumer group)", "Kafka protocol")
Rel(kafka, notification, "auth events (consumer group)", "Kafka protocol")

SHOW_LEGEND()
@enduml
