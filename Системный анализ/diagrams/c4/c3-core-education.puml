@startuml c3-core-education
!include <C4/C4_Component>

title Trajectory — C3: Core Education Service (components)

Container(gateway, "API Gateway", "Go", "REST -> gRPC")
Container(realtime, "Realtime Service", "Go")
Container(billing, "Billing Service", "Go")
Container(learning, "Learning Service", "Go", "Материалы и прогресс")
Container(notification, "Notification Service", "Go", "Inbox и доставка")
ContainerQueue(kafka, "Apache Kafka", "KRaft")
ContainerDb(pg_edu, "education_db", "PostgreSQL")
ContainerDb(minio, "MinIO", "S3")
System_Ext(livekit, "LiveKit", "WebRTC SFU")

Container_Boundary(core, "Core Education Service") {
    Component(grpc_api, "gRPC API (education.v1)", "Go, grpc-go", "Единая точка входа: интерсепторы OTel, auth-context, deadlines")

    Component(scheduling, "scheduling", "Go package", "Доступность преподавателей, слоты, recurring-правила, календарь")
    Component(booking, "booking", "Go package", "Booking-сага; отдельные price snapshot и hold на ученика; cancellation policy")
    Component(lessons, "lessons", "Go package", "Жизненный цикл, attendance, новая комната и доска на каждый lesson_id")
    Component(recordings, "recordings", "Go package", "Согласия, LiveKit Egress, S3 metadata, удаление через 1 месяц")
    Component(chats, "chats", "Go package", "Личные/групповые/комнатные чаты: сообщения, вложения (MinIO), статусы прочтения, поиск")
    Component(support, "support", "Go package", "Тикеты: open / pending / resolved / closed")
    Component(uploads, "uploads", "Go package", "Выдача presigned URL после проверки прав")
    Component(outbox_relay, "outbox relay", "Go goroutine", "aggregate lock -> version order -> Kafka publish -> published_at")
    Component(consumers, "event consumers", "Go goroutines", "Kafka consumer group: payment.captured, user.registered; dedup event_id")
}

Rel(gateway, grpc_api, "Все клиентские операции", "gRPC")
Rel(realtime, grpc_api, "SaveMessage, авторизация комнат", "gRPC")

Rel(grpc_api, scheduling, "вызывает")
Rel(grpc_api, booking, "вызывает")
Rel(grpc_api, lessons, "вызывает")
Rel(grpc_api, recordings, "вызывает")
Rel(grpc_api, chats, "вызывает")
Rel(grpc_api, support, "вызывает")
Rel(grpc_api, uploads, "вызывает")

Rel(booking, billing, "PlaceHold (Idempotency-Key, deadline)", "gRPC")
Rel(lessons, livekit, "Минт токенов, закрытие комнат", "Server SDK")
Rel(recordings, livekit, "Start/Stop Egress", "Server SDK")
Rel(livekit, lessons, "Вебхуки participant_*, room_finished", "HTTPS")
Rel(uploads, minio, "Presigned URL", "S3 API")

Rel(scheduling, pg_edu, "R/W", "SQL")
Rel(booking, pg_edu, "R/W + outbox в одной транзакции", "SQL")
Rel(lessons, pg_edu, "R/W + outbox", "SQL")
Rel(recordings, pg_edu, "R/W + outbox", "SQL")
Rel(chats, pg_edu, "R/W", "SQL")
Rel(support, pg_edu, "R/W", "SQL")

Rel(outbox_relay, pg_edu, "читает outbox", "SQL")
Rel(outbox_relay, kafka, "publish education events", "Kafka protocol")
Rel(kafka, consumers, "deliver auth/billing/learning events", "Kafka protocol")
Rel(kafka, learning, "lesson.completed, lesson.recorded", "Kafka protocol")
Rel(kafka, notification, "booking.*, lesson.*", "Kafka protocol")

SHOW_LEGEND()
@enduml
