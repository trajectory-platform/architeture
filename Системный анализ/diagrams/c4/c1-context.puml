@startuml c1-context
!include <C4/C4_Context>

title Trajectory — C1: System Context

Person(student, "Student", "Ученик: бронирует уроки, учится по курсам, выполняет задания и тесты")
Person(teacher, "Teacher", "Преподаватель: ведёт уроки, курсы и группы, проверяет работы")
Person(representative, "Representative", "Представитель: оплачивает и бронирует занятия ученика")
Person(admin, "Admin", "Администратор платформы: управление, поддержка, финансы и аудит")

System(trajectory, "Trajectory Platform", "Платформа индивидуального и группового обучения: курсы, бронирование, уроки, CRDT-доска, задания, тесты, материалы, деньги и уведомления")

System_Ext(livekit, "LiveKit (WebRTC SFU)", "Медиа-сервер: видео, аудио, screen share. Развёрнут рядом с платформой, но является сторонним готовым компонентом")
System_Ext(email, "Email provider", "Транзакционные письма: подтверждение email, восстановление и приглашения")

Rel(student, trajectory, "Бронирует уроки, участвует в занятиях, общается", "HTTPS / WSS")
Rel(teacher, trajectory, "Управляет расписанием, ведёт уроки, отчитывается", "HTTPS / WSS")
Rel(representative, trajectory, "Бронирует и оплачивает занятия подопечного", "HTTPS")
Rel(admin, trajectory, "Обрабатывает тикеты поддержки, администрирует", "HTTPS")

Rel(student, livekit, "Видео/аудио во время урока", "WebRTC")
Rel(teacher, livekit, "Видео/аудио во время урока", "WebRTC")

Rel(trajectory, livekit, "Минтит access-токены, закрывает комнаты", "Server SDK / HTTPS")
Rel(livekit, trajectory, "Вебхуки: participant_joined, room_finished", "HTTPS")
Rel(trajectory, email, "Отправляет транзакционные уведомления", "HTTPS")

SHOW_LEGEND()
@enduml
