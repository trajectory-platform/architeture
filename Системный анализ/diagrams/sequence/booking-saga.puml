@startuml booking-saga
title MVP 1.0: индивидуальная booking saga (групповой цикл — 04)

actor "Student (SPA)" as spa
participant "API Gateway" as gw
participant "Core Education\n(booking)" as core
database "education_db" as edb
participant "Billing" as billing
database "billing_db" as bdb
queue "Apache Kafka" as kafka

spa -> gw: POST /bookings\nIdempotency-Key: K
gw -> gw: валидация JWT (JWKS, локально)
gw -> core: CreateBooking\nmetadata: idempotency-key=K, deadline

group Транзакция №1 (education_db)
  core -> edb: advisory lock (teacher_id)
  core -> edb: INSERT bookings + booking_participants\nparticipant_id, price/policy snapshot, PENDING
  note right of edb
    EXCLUDE USING gist
    (teacher_id WITH =, time_range WITH &&)
    пересечение -> ошибка constraint
  end note
end

alt слот пересекается
  edb --> core: exclusion violation
  core --> gw: FailedPrecondition (slot taken)
  gw --> spa: 409 Conflict
else слот свободен
  core -> billing: PlaceHold(student, fixed_amount,\nreference=participant_id, key=place-hold:participant_id)
  group Транзакция Billing (billing_db)
    billing -> bdb: SELECT account FOR UPDATE\nscoped key + request_hash
    billing -> bdb: баланс = SUM(ledger) - активные холды
    billing -> bdb: INSERT holds (reference UNIQUE, scoped key, hash)
  end

  alt недостаточно средств
    billing --> core: ResourceExhausted
    core -> edb: participant FAILED; booking FAILED\nесли нет других PENDING/CONFIRMED
    core --> gw: ResourceExhausted
    gw --> spa: 402 insufficient funds
  else холд размещён
    billing --> core: HoldPlaced(hold_id)
    group Транзакция №2 (education_db)
      core -> edb: CAS participant -> CONFIRMED\nbooking CONFIRMED; lesson + membership
      core -> edb: INSERT outbox('booking.confirmed')
    end
    core --> gw: Booking{CONFIRMED}
    gw --> spa: 201 Created
    core -> kafka: (outbox relay) publish booking.confirmed\nkey=booking_id, acks=all
  else таймаут / исход неизвестен
    note over core
      Booking остаётся PENDING.
      Reconciler повторяет PlaceHold с participant key —
      Billing вернёт сохранённый результат,
      сага доводится до CONFIRMED или FAILED.
    end note
  end
end
note over core,billing
  Cancel intent блокирует позднее подтверждение.
  Неизвестный hold сначала разрешается, затем компенсируется.
  Группа 2.0: одна booking row, до 7 мест под row lock,
  отдельный ключ и hold на каждое место.
end note
@enduml
