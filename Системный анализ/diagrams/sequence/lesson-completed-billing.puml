@startuml lesson-completed-billing
title Завершение урока: списание с учеников и обновление прогресса

participant "LiveKit" as lk
participant "Core Education" as core
database "education_db" as edb
queue "Apache Kafka" as kafka
participant "Billing\n(consumer group)" as billing
database "billing_db" as bdb
participant "Learning\n(consumer group)" as learning
database "learning_db" as ldb
participant "Notification\n(consumer group)" as notification

lk -> core: подписанный webhook (может не доставиться)
core -> edb: durable webhook inbox, UNIQUE provider event ID
core -> core: EndLesson / timer / reconciliation\nпроверить attendance + policy; CAS outcome
note over core
  room_finished не доказывает состоявшийся урок.
  Неоднозначный исход -> очередь разбора.
end note
group Transaction education_db
  core -> edb: lesson=COMPLETED\nattendance per student
  core -> edb: INSERT outbox lesson.completed\nparticipant outcomes
end
core -> kafka: publish lesson.completed\nkey=lesson_id, acks=all

par Billing: деньги
  kafka -> billing: lesson.completed
  group Одна ограниченная transaction billing_db
  billing -> bdb: receipt event_id; lock accounts в порядке ID
  loop каждый student participant
    alt присутствовал или пропустил free-cancel window
      billing -> bdb: hold ACTIVE -> CAPTURED\nfixed price debit/credit
    else своевременно отменил
      billing -> bdb: hold -> RELEASED / partial result
    end
  end
  billing -> bdb: INSERT receipt + outbox по каждому outcome
  end
  billing -> kafka: после commit: contiguous next offset
  billing -> kafka: publish payment.captured
else Learning: прогресс
  kafka -> learning: lesson.completed
  group Transaction learning_db
    learning -> ldb: INSERT processed_events(event_id)\nON CONFLICT DO NOTHING
    learning -> ldb: update progress только\nдля фактически участвовавших
  end
  learning -> kafka: commit lesson offset
else Notification
  kafka -> notification: lesson.completed
  notification -> notification: materialize inbox idempotently
  notification -> kafka: commit lesson offset
end

kafka -> core: payment.captured
core -> edb: update payment projection
core -> kafka: commit billing offset

note over kafka
  Consumer groups независимы.
  Offset фиксируется только после DB commit.
  Повтор того же outcome безопасен по event_id.
  Противоположный terminal outcome -> reconciliation.
end note
@enduml
